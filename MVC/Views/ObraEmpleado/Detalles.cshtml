@model LogicaNegocio.Entidades.ObraEmpleado

@{
    ViewData["Title"] = "Detalles";
}

<h1>Detalles</h1>

<div>
    <h4>ObraEmpleado</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IdObra)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IdObra)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IdEmpleado)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IdEmpleado)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FechaIngreso)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FechaIngreso)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FechaEgreso)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FechaEgreso)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Editar" asp-controller="ObraEmpleado" asp-route-idempleado="@Model?.Empleado.Id" asp-route-idobra="@Model?.Obra.IdObra">Editar</a>|
    <a href="@Url.Action("Empleados","Obra", new{idObra = Model?.Obra.IdObra})">Empleados de la obra</a>|
</div>
