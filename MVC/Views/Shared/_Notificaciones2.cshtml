@using System.Text.Json;
@using Microsoft.AspNetCore.Http;
@using LogicaNegocio.Entidades;

@{
    string solicitudes = Context.Session.GetString("SolicitudesPendientes");
    string solicitudesAprob = Context.Session.GetString("SolicitudesAprobadas");
    string solicitudesConfirmadas = Context.Session.GetString("SolicitudesConfirmadas");
    string alertasDeStock = Context.Session.GetString("MaterialesAlertar");


    if (Context.Session.GetString("UsuarioTipo") == "Usuario de oficina")
    {



        <div class="dropend">


            @if (solicitudes != null)
            {
                List<Solicitud> solicitudesList = JsonSerializer.Deserialize<List<Solicitud>>(solicitudes);
                int cantSoli = solicitudesList.Count();

                <span class="badge bg-primary rounded-pill">
                    @cantSoli
            </span>

            }
            <button class="btn btn-Primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                Solicitudes pendientes
                @*Aca iria la Campanita*@
            </button>
            @if (solicitudes != null)
            {

                List<Solicitud> solicitudesList = JsonSerializer.Deserialize<List<Solicitud>>(solicitudes);
            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton1">



                @foreach (Solicitud soli in solicitudesList)
                {

                    <li class="list-group">
                            <a class="list-group-item list-group-item-action" href="@Url.Action("Detalles", "Solicitud", new { idSolicitud = soli.Id, idObra = soli.IdObra})">Solicitud de la obra: @soli.Obra.Nombre</a>
                    </li>

                }
               
             </ul>
                }else{
                    <span class="badge bg-primary rounded-pill">
                0
            </span>
            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton1">
                </ul>

                }
        </div>





        <div class="dropend">
          @if(solicitudesConfirmadas != null)
         {
                List<Solicitud> solicitudesListConf = JsonSerializer.Deserialize<List<Solicitud>>(solicitudesConfirmadas);

                int cantSoli2 = solicitudesListConf.Count();



            <span class="badge bg-primary rounded-pill">
                @cantSoli2
            </span>
         }
            <button class="btn btn-Primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                Solicitudes confirmadas
                @*Aca iria la Campanita*@
            </button>


                @if (solicitudes != null)
                {
                List<Solicitud> solicitudesListConf = JsonSerializer.Deserialize<List<Solicitud>>(solicitudesConfirmadas);

            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton1">



                @foreach (Solicitud soli in solicitudesListConf)
                {

                    <li class="list-group">
                            <a class="list-group-item list-group-item-action" href="@Url.Action("Detalles", "Solicitud", new { idSolicitud = soli.Id, idObra = soli.IdObra})">Se confirmo la solicitud de la obra: @soli.Obra.Nombre</a>
                    </li>

                }


            </ul>
            }
            else
            {
                <span class="badge bg-primary rounded-pill">
                    0
                </span>
                <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton1">
                </ul>

            }
            </div>

        <div class="dropend">
            @if (alertasDeStock != null)
            {
                List<ObraMaterial> materialesAlertar = JsonSerializer.Deserialize<List<ObraMaterial>>(alertasDeStock);

                int cantMaterial = materialesAlertar.Count();
                <span class="badge bg-primary rounded-pill">
                    @cantMaterial
                </span>
            }
            <button class="btn btn-Primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                Alertas de stock en obra
                @*Aca iria la Campanita*@
            </button>
                @if (alertasDeStock != null)
                {
                List<ObraMaterial> materialesAlertar = JsonSerializer.Deserialize<List<ObraMaterial>>(alertasDeStock);

                <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton1">
                @foreach (ObraMaterial om in materialesAlertar)
                {

                    <li class="list-group">
                            <a class="list-group-item list-group-item-action" href="@Url.Action("Materiales", "Obra", new { id = om.Obra.IdObra })">En la obra @om.Obra.Nombre el stock de @om.Material.Nombre bajó de la barrera definida</a>
                    </li>

                }
                </ul>
            }
            
        </div>
    }



    if (Context.Session.GetString("UsuarioTipo") == "Usuario de obra")
    {
        
    if (solicitudesAprob != null)
    {
        List<Solicitud> solicitudesListApro = JsonSerializer.Deserialize<List<Solicitud>>(solicitudesAprob);
        int cantSoli3 = solicitudesListApro.Count();

            <span class="badge bg-primary rounded-pill">
                @cantSoli3
            </span>

          <div class="dropend">

            <button class="btn btn-Primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                Solicitudes aprobadas
                @*Aca iria la Campanita*@
            </button>



            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton1">



                @foreach (Solicitud soli in solicitudesListApro)
                {

                    <li class="list-group">
                            <a class="list-group-item list-group-item-action" href="@Url.Action("Confirmar", "Solicitud", new { idSolicitud = soli.Id })">Se aprobo la solicitud de: @soli.Obra.Nombre</a>
                    </li>

                }


            </ul>
        </div>

    }

    }
    




}

