        <nav id="layout" class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3 navbar-left">

            <button class="btnBurga btn-primary" type="button" onclick="mostrarOcultar()">
                <span class="navbar-toggler-icon"></span>
            </button>

                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index"> <img class="navbarImg" src="~/css/imagenes/LOGOTIPO negro2.png" /></a>

                    <ul class="navbar-nav flex-column">
