                                <a class="nav-link text-dark" asp-area="" asp-controller="Empleado" asp-action="Liquidar">Liquidacion</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Plano" asp-action="Index">Plano</a>
