<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] Bodega y Piedrafita</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/MVC.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Layout.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

    <link rel="stylesheet" href="~/css/FormularioResponsive.css">
</head>

<body>
    <div id="capaDeFondo"></div>
    <header id="headerCompu">
        <div class="flexContainer">

            @*  <div class="contenedorLogo">
            <img class="imgLogo" src="~/css/Imagenes/logo negro.png" alt="Logo" />
            </div> *@
            @*  <div class="containerLogout">
            <a class="btn btn-danger " asp-controller="Usuario" asp-action="CerrarSesion">Cerrar sesión</a>

            </div>
            *@
        </div>
        <nav class="navbar navbar-expand-lg ">
            @*  <div class="container-fluid">
            <div class="collapse navbar-collapse"> *@
            <div class="contenedorLogo">
                @* <img class="imgLogo" src="~/css/imagenes/logo blanco.png" /> *@
                @*   <img class="imgLogo" src="~/css/imagenes/logotipo blanco.png" /> *@
            </div>

            <ul id="ulNav" class="navbar-nav ms-auto">
                @if (Context.Session.GetString("UsuarioLogueado") != null && Context.Session.GetString("UsuarioTipo") != "Usuario administrador")
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Obra" asp-action="Index">Obra</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Material" asp-action="Index">Material</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Empleado" asp-action="Index">Empleado</a>
                    </li>
                    @if (Context.Session.GetString("UsuarioTipo") == "Usuario de oficina")
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Empleado" asp-action="Liquidar">Liquidación</a>
                        </li>

                    }


                    <partial name="_Notificaciones2" class="nav-link " />


                    @* _Notificaciones2 *@
                    @*   <li class="nav-item">

                <a id="btnLoginLogout" class="btn btn-danger " asp-controller="Usuario" asp-action="CerrarSesion">Cerrar sesión</a>
                </li> *@

                }
                else if (Context.Session.GetString("UsuarioLogueado") != null && Context.Session.GetString("UsuarioTipo") == "Usuario administrador")
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Usuario" asp-action="Listado">Lista de Usuarios</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Usuario" asp-action="Agregar">Registrar Usuario</a>
                    </li>


                }

            </ul>
            <div class="containerLogout">
                <a class="btn btn-danger  btnLogOut " asp-controller="Usuario" asp-action="CerrarSesion">Cerrar sesión</a>

            </div>
            @*  </div>
            </div> *@
        </nav>
    </header>

    @*///////////////////////////////////////////////////////////////   CELU  ////////////////////////////////////////////////////////////////////////////////////*@


    <header id="headerCelu">
        <nav id="layout" class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light mb-3 navbar-left">
            <button id="btnBurga" class="btnBurga btn-primary" type="button" onclick="mostrarOcultar()">
                <span class="navbar-toggler-icon"></span>
            </button>

            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index"> <img class="navbarImg" src="~/css/Imagenes/LOGOTIPO blanco.png" /></a>

            <ul class="navbar-nav flex-column">
                @if (Context.Session.GetString("UsuarioLogueado") != null && Context.Session.GetString("UsuarioTipo") != "Usuario administrador")
                {
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Obra" asp-action="Index">Obra</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Material" asp-action="Index">Material</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Empleado" asp-action="Index">Empleado</a>
                    </li>
                    @if (Context.Session.GetString("UsuarioTipo") == "Usuario oficina")
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Empleado" asp-action="Liquidar">Liquidación</a>
                        </li>

                    }
                    <partial name="_Notificaciones2" />
                }
                else if (Context.Session.GetString("UsuarioLogueado") != null && Context.Session.GetString("UsuarioTipo") == "Usuario administrador")
                {
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Usuario" asp-action="Listado">Lista de Usuarios</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Usuario" asp-action="Agregar">Registrar Usuario</a>
                    </li>
                }
            </ul>
        </nav>

        <div class="btnLoginLogout">

            @if (Context.Session.GetString("UsuarioLogueado") != null)
            {
                <div class="containerLogout">
                    <a id="btnLoginLogout" class="btn btn-danger " asp-controller="Usuario" asp-action="CerrarSesion">Cerrar sesión</a>

                </div>

            }

        </div>

    </header>


    @*///////////////////////////////////////////////////////////////   CELU  ////////////////////////////////////////////////////////////////////////////////////*@


    <div class="contenedor">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

<footer>
    <div class="contenedorFooter">
        &copy; 2024 - Bodega & Piedrafita A - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
    </div>
</footer>
</html>


