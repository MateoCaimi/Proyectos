

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] Bodega y Piedrafita</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/MVC.styles.css" asp-append-version="true" />
</head>
 
<body>
  
    <header>
        
        
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3 navbar-left">
            
            <button class="btnBurga btn-primary" type="button">
                <span class="navbar-toggler-icon"></span>
            </button>
            
           
                    <h2>
                        <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">B&P</a>
                    </h2>

                    <ul class="navbar-nav flex-column">
                        @if (Context.Session.GetString("UsuarioLogueado") != null && Context.Session.GetString("UsuarioTipo") != "Usuario administrador")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Obra" asp-action="Index">Obra</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Material" asp-action="Index">Material</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Empleado" asp-action="Index">Empleado</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Empleado" asp-action="Liquidar">Liquidacion</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Plano" asp-action="Index">Plano</a>
                            </li>
                            <partial name="_Notificaciones2" />
                        }
                        else if (Context.Session.GetString("UsuarioLogueado") != null && Context.Session.GetString("UsuarioTipo") == "Usuario administrador")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Usuario" asp-action="Listado">Lista de Usuarios</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Usuario" asp-action="Agregar">Registrar Usuario</a>
                            </li>
                        }
                    </ul>
        </nav>
        
       <div class="btnLoginLogout">

            @if (Context.Session.GetString("UsuarioLogueado") != null)
            {
                    <a class="btn btn-primary" asp-controller="Usuario" asp-action="CerrarSesion">Cerrar sesion</a>
               
            }
            else
            {
                    <a class="btn btn-primary" asp-controller="Usuario" asp-action="Index">Iniciar sesion</a>
            }

       </div>
              
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2024 - MVC - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
    </div>
</footer>

</html>
