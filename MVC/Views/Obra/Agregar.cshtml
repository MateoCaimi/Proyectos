@model LogicaNegocio.Entidades.Obra

@{
    ViewData["Title"] = "Agregar";
}

<meta charset="UTF-8">
<link rel="stylesheet" href="~/css/Obra/AgregarObra.css">

<h1>Agregar obra</h1>

<hr />
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}
<br />
<div class="containerForm row">
    <div class="col-md-4">
        <form  asp-action="Agregar" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="FechaInicio" class="control-label"></label>
                <input asp-for="FechaInicio" class="form-control" />
                <span asp-validation-for="FechaInicio" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="Nombre" class="control-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="Direccion" class="control-label"></label>
                <input asp-for="Direccion" class="form-control" />
                <span asp-validation-for="Direccion" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="IdACargo" class="control-label"></label>
                <select asp-for="IdACargo" class="form-control" >
                    @foreach(var item in ViewBag.Usuarios)
                    {
                        <option value="@item.Id">@item.Nombre</option>
                    }
                </select>
                <span asp-validation-for="IdACargo" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label for="archivoImagen">Subir Cronograma</label>
                <input type="file" name="archivoImagen" id="archivoImagen" class="form-control" />
            </div>
            <br />
            <div class="form-group">
                <input type="submit" value="Agregar obra" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>



<div class="containerVolver">
    <a class="volver" asp-action="Index">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-return-left" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M14.5 1.5a.5.5 0 0 1 .5.5v4.8a2.5 2.5 0 0 1-2.5 2.5H2.707l3.347 3.346a.5.5 0 0 1-.708.708l-4.2-4.2a.5.5 0 0 1 0-.708l4-4a.5.5 0 1 1 .708.708L2.707 8.3H12.5A1.5 1.5 0 0 0 14 6.8V2a.5.5 0 0 1 .5-.5" />
        </svg>
        Volver al listado de obras
    </a>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var checkboxFinalizada = document.getElementById("Finalizada");
            var fechaFinalizacion = document.getElementById("FechaFinalizacion");

            function toggleFechaFinalizacion() {
                fechaFinalizacion.disabled = !checkboxFinalizada.checked;
            }

            // Inicializar al cargar página
            toggleFechaFinalizacion();
            checkboxFinalizada.addEventListener("change", toggleFechaFinalizacion);
        });
    </script>
}
