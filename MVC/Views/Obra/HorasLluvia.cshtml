@model LogicaNegocio.Entidades.Obra

@{
    ViewData["Title"] = "Asignación de horas lluvia";
}

<meta charset="UTF-8">
<link rel="stylesheet" href="~/css/Obra/AsignarHoraLluvia.css">

<h1>Asignación de horas lluvia</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-info">
        @ViewBag.Mensaje
    </div>
}

<div class="containerForm row">
    <div class="col-md-4">
        <form asp-action="HorasLluvia" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdObra" />
            <div class="form-group">
                <label>Cantidad de horas</label>
                <input type="number" class="form-control" name="HorasLluvia" />
            </div>
            <div class="form-group">
                <label for="Dia" class="control-label">Seleccione el dia</label>
                <input for="Dia" class="form-control" type="date" name="Dia" />
                <span for="Dia" class="text-danger"></span>
            </div>
                <input type="submit" value="Asignar" class="btn btn-primary" />
        </form>
    </div>
</div>

<div class="containerVolver">
    <a class="volver" asp-action="Detalles" asp-route-id="@Model.IdObra">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-return-left" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M14.5 1.5a.5.5 0 0 1 .5.5v4.8a2.5 2.5 0 0 1-2.5 2.5H2.707l3.347 3.346a.5.5 0 0 1-.708.708l-4.2-4.2a.5.5 0 0 1 0-.708l4-4a.5.5 0 1 1 .708.708L2.707 8.3H12.5A1.5 1.5 0 0 0 14 6.8V2a.5.5 0 0 1 .5-.5" />
        </svg>
        Volver a la obra
    </a>
</div>