@model LogicaNegocio.Entidades.Obra

@{
    ViewData["Title"] = "Cerrar obra";
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<link rel="stylesheet" href="~/css/Obra/CerrarObra.css">
<link rel="stylesheet" href="~/css/FormularioResponsive.css">

<h1>Cerrar obra</h1>

<h3>¿Estás seguro que quieres cerrar esta obra?</h3>
<form asp-action="Cerrar">
    <div class="form-group">
        <input type="hidden" asp-for="IdObra" />
        <input type="submit" value="Cerrar" class="btn btn-primary" /> 
    </div>
</form>

<div class="containerVolver">
    <a class="volver" asp-action="Detalles" asp-route-id="@Model.IdObra">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-return-left" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M14.5 1.5a.5.5 0 0 1 .5.5v4.8a2.5 2.5 0 0 1-2.5 2.5H2.707l3.347 3.346a.5.5 0 0 1-.708.708l-4.2-4.2a.5.5 0 0 1 0-.708l4-4a.5.5 0 1 1 .708.708L2.707 8.3H12.5A1.5 1.5 0 0 0 14 6.8V2a.5.5 0 0 1 .5-.5" />
        </svg>
        Volver a la obra
    </a>
</div>