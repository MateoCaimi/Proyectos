@model LogicaNegocio.ViewModel.ObraEstadisticasViewModel

@{
    ViewData["Title"] = "Detalles";
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<h1>Detalles</h1>

<div>
    <h4>Obra</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Obra.FechaInicio)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Obra.FechaInicio)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Obra.FechaFinalizacion)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Obra.FechaFinalizacion)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Obra.Nombre)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Obra.Nombre)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Obra.Direccion)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Obra.Direccion)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Obra.Finalizada)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Obra.Finalizada)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Obra.UsuarioACargo.Nombre)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Obra.UsuarioACargo.Nombre)
        </dd>
    </dl>
</div>

@if (Model.Obra.Finalizada)
{
    <div>
        <h5>Estadísticas de obra</h5>
        <dt class="col-sm-2">
            Material más solicitado
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MaterialMasSolicitado)
        </dd>
        <dt class="col-sm-2">
            Material menos solicitado
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MaterialMenosSolicitado)
        </dd>
        <dt class="col-sm-2">
            Solicitante más común
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.SolicitanteMasComun)
        </dd>
        <dt class="col-sm-2">
            Proveedor más común
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ProveedorMasComun)
        </dd>
    </div>
}

<div>
    <a asp-action="Editar" asp-route-id="@Model?.Obra.IdObra">Modificar</a> |
    <a asp-action="Eliminar" asp-route-id="@Model?.Obra.IdObra">Eliminar</a>|
    
    @if (!Model.Obra.Finalizada)
    {
        <a asp-action="Cerrar" asp-route-id="@Model?.Obra.IdObra">| Cerrar Obra</a>
    }
    <a href="@Url.Action("Index","Plano", new{idObra = Model?.Obra.IdObra})">Planos</a>|

    <a asp-action="ObtenerQr" asp-route-id="@Model?.Obra.IdObra">Código QR</a>|

    <a asp-action="Materiales" asp-route-id="@Model?.Obra.IdObra">Materiales</a>|

    <a href="@Url.Action("Index","Solicitud", new{idObra = Model?.Obra.IdObra})">Ver solicitudes</a>|

    <a href="@Url.Action("Consumo","Obra", new{idObra = Model?.Obra.IdObra})">Consumir materiales</a>|

    <a asp-action="Index">Back to List</a>
</div>
