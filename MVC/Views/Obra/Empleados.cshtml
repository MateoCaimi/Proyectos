@model IEnumerable<LogicaNegocio.Entidades.ObraEmpleado>

@{
    ViewData["Title"] = "Index";
}

<meta charset="UTF-8">
<link rel="stylesheet" href="~/css/Empleado/IndexEmpleado.css">
<link href="~/css/tablasresponsive.css" rel="stylesheet" />

<h1>Empleados de la obra</h1>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Empleado.Nombre)
            </th>
            <th class="tablaAEsconder600">
                @Html.DisplayNameFor(model => model.Empleado.Cedula)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Empleado.TipoEmpleado.Categoría)
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr onclick="location.href='@Url.Action("Detalles","ObraEmpleado", new { id = item.IdObra })'" style="cursor:pointer;">
                <td>
                    @Html.DisplayFor(modelItem => item.Empleado.Nombre)
                </td>
                <td class="tablaAEsconder600">
                    @Html.DisplayFor(modelItem => item.Empleado.Cedula)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Empleado.TipoEmpleado.Categoría)
                </td>
            </tr>
        }
    </tbody>
</table>


<div class="containerVolver">
    <a class="volver" asp-action="Detalles" asp-route-id="@ViewBag.IdObra">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-return-left" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M14.5 1.5a.5.5 0 0 1 .5.5v4.8a2.5 2.5 0 0 1-2.5 2.5H2.707l3.347 3.346a.5.5 0 0 1-.708.708l-4.2-4.2a.5.5 0 0 1 0-.708l4-4a.5.5 0 1 1 .708.708L2.707 8.3H12.5A1.5 1.5 0 0 0 14 6.8V2a.5.5 0 0 1 .5-.5" />
        </svg>
        Volver a la obra
    </a>
</div>