@model IEnumerable<LogicaNegocio.ViewModel.MaterialConsumoViewModel>

@{
    ViewData["Title"] = "Materiales de obra";
}

<h2>Consumo de material</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" id="errorMensaje">
        @TempData["Error"]
    </div>
}
else
{
    <div class="alert alert-danger" id="errorMensaje" style="display:none;">
    </div>
}


<form action="ConsumoPost" method="post">


    @Html.AntiForgeryToken()

    <div>
        <label>Nombre de la obra</label>
        <input type="text" class="form-control" value="@ViewBag.NombreObra" readonly="readonly" />
        <input type="hidden" class="form-control" value="@ViewBag.IdObra" name="IdObra" />
    </div>

    <div>
        <label>Material</label>
        <select id="Material" name="IdMaterial" class="form-control">
            @foreach (var item in ViewBag.Materiales)
            {
                <option value="@item.IdMaterial">@item.Material.Nombre (@item.Material.UnidadDeMedida) Stock= @item.Stock </option>
            }
        </select>
        <label>Cantidad</label>
        <input type="number" name="Cantidad" class="form-control" />
        <button type="button" id="addItem" class="btn btn-primary">Consumir</button>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Material</th>
                <th>Cantidad</th>
            </tr>
        </thead>
        <tbody id="materialList">
            @Html.Partial("ListaConsumos", Model);
        </tbody>
    </table>

    <button type="submit" value="ConsumoPost" class="btn btn-success">Enviar</button>

</form>

@section Scripts {
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script>
        $(document).ready(function () {
            $("#addItem").click(function () {
                var nuevoMaterialId = $("select[name='IdMaterial'] option:selected").val();
                var nuevoMaterialTexto = $("select[name='IdMaterial'] option:selected").text();
                var nuevaCantidad = parseFloat($("input[name='Cantidad']").val());

                if (nuevoMaterialId != null && nuevaCantidad > 0) {
                    $.ajax({
                        url: '@Url.Action("Consumir", "Obra")',
                        type: 'POST',
                        data: {
                            IdMaterial: nuevoMaterialId,
                            Cantidad: nuevaCantidad,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (response) {
                            $("#materialList").html(response);
                            $("input[name='Cantidad']").val('');
                            $("#errorMensaje").hide();
                            
                        },
                        error: function () {
                            $("#errorMensaje").text("Error al agregar el material a la lista de consumo. Inténtalo de nuevo.");
                            $("#errorMensaje").show();
                        }
                    });
                } else {
                    $("#errorMensaje").text("Agregue una cantidad válida");
                    $("#errorMensaje").show();
                }
            });
        });
    </script>
}
