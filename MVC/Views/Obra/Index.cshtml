@model IEnumerable<LogicaNegocio.Entidades.Obra>

@{
    ViewData["Title"] = "Index";
}


<meta charset="UTF-8">
<link rel="stylesheet" href="~/css/Obra/IndexObra.css">
<link href="~/css/tablasresponsive.css" rel="stylesheet" />
<h1>Obras</h1>

@if (Context.Session.GetString("UsuarioTipo") == "Usuario de oficina")
{
    <p>
        <a asp-action="Agregar">Agregar obra nueva</a>
    </p>
}

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Nombre)</th>
            <th class="columnaAEsconderObra">@Html.DisplayNameFor(model => model.Direccion)</th>
            <th>@Html.DisplayNameFor(model => model.Cronograma)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var finalizadas = item.Finalizada ? "resaltar-rojo" : "";
         <tr class="@finalizadas" onclick="location.href='@Url.Action("Detalles", new { id = item.IdObra })'" style="cursor:pointer;">

                <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                <td class="columnaAEsconderObra">@Html.DisplayFor(modelItem => item.Direccion)</td>
                <td>
                    @if (item.Cronograma != null)
                    {
                        <a href="@Url.Action("ObtenerCronograma", "Obra", new { id = item.IdObra })" target="_blank">Ver Cronograma</a>
                    }
                    else
                    {
                        <p>No hay cronograma</p>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>


