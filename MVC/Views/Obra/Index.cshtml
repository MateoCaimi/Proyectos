@model IEnumerable<LogicaNegocio.Entidades.Obra>

@{
    ViewData["Title"] = "Index";
}

<h1>Obras</h1>

@if(Context.Session.GetString("UsuarioTipo") == "Usuario de oficina")
{
<p>
    <a asp-action="Agregar">Agregar obra nueva</a>
</p>
}
<table class="table">
    <thead>
        <tr>
           @*  <th>
                @Html.DisplayNameFor(model => model.FechaInicio)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaFinalizacion)
            </th> *@
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Direccion)
            </th>
          @*   <th>
                @Html.DisplayNameFor(model => model.Finalizada)
            </th> *@
            <th>
                @Html.DisplayNameFor(model => model.Cronograma)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
     var finalizadas = item.Finalizada ? "resaltar-rojo" : "";
        <tr class="@finalizadas">
        
            @* <td>
                @Html.DisplayFor(modelItem => item.FechaInicio)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FechaFinalizacion)
            </td> *@
            <td>
                @Html.DisplayFor(modelItem => item.Nombre)  
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Direccion)
            </td>
          @*   <td>
                @Html.DisplayFor(modelItem => item.Finalizada)
            </td> *@
            <td>
                    @if (item.Cronograma != null)
                    {
                        <a href="@Url.Action("ObtenerCronograma", "Obra", new { id = item.IdObra })" target="_blank">Ver Cronograma</a>

                    }else
                    {
                        <p>No hay cronograma</p>
                    }
           <td>
            <td>
                <a asp-action="Detalles" asp-route-id="@item.IdObra">Detalles</a>
            </td>
        </tr>
}
    </tbody>
</table>

<style>
    .resaltar-rojo {
        color: red;
    }
</style>



