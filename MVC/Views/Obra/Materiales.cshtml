@model IEnumerable<LogicaNegocio.Entidades.ObraMaterial>

@{
    ViewData["Title"] = "Materiales de Obra";
}

<meta charset="UTF-8">
<link rel="stylesheet" href="~/css/Obra/MaterialesObra.css">


<h1>Materiales de la Obra</h1>



<p>
    <a asp-action="Crear" asp-controller="Solicitud" asp-route-idobra="@ViewBag.idObra">Crear una solicitud</a>
</p>
<p>
    <a asp-action="Consumo" asp-controller="Obra" asp-route-idobra="@ViewBag.idObra">Consumir materiales</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Material.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Stock)
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.Material.Nombre (@item.Material.UnidadDeMedida)
                </td>
                <td>
                    @item.Stock
                </td>
            </tr>
        }
    </tbody>
</table>