@model IEnumerable<LogicaNegocio.Entidades.ObraMaterial>

@{
    ViewData["Title"] = "Materiales de Obra";
}

<meta charset="UTF-8">
<link rel="stylesheet" href="~/css/Obra/MaterialesObra.css">

<h1>Materiales de la Obra @ViewBag.NomObra</h1>



<div class="containerMatsObra">
    <a asp-action="Crear" asp-controller="Solicitud" asp-route-idobra="@ViewBag.idObra">Crear una solicitud</a>
    <a asp-action="Consumo" asp-controller="Obra" asp-route-idobra="@ViewBag.idObra">Consumir materiales</a>

</div>


<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Material.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Stock)
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.Material.Nombre (@item.Material.UnidadDeMedida)
                </td>
                <td>
                    @item.Stock
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="containerVolver">
    <a class="volver" asp-action="Detalles" asp-route-id="@ViewBag.idObra">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-return-left" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M14.5 1.5a.5.5 0 0 1 .5.5v4.8a2.5 2.5 0 0 1-2.5 2.5H2.707l3.347 3.346a.5.5 0 0 1-.708.708l-4.2-4.2a.5.5 0 0 1 0-.708l4-4a.5.5 0 1 1 .708.708L2.707 8.3H12.5A1.5 1.5 0 0 0 14 6.8V2a.5.5 0 0 1 .5-.5" />
        </svg>
        Volver a la obra
    </a>
</div>