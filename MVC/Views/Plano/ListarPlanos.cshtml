@model IEnumerable<LogicaNegocio.Entidades.Plano>

@{
    ViewData["Title"] = "ListarPlanos";
}
<link href="~/css/empleado/indexempleado.css" rel="stylesheet" />
<link href="~/css/tablasresponsive.css" rel="stylesheet" />
<h1>Listado de Planos</h1>


@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}


<h4> @ViewBag.Tipo.Categoria</h4>


