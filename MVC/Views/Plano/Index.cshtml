@model IEnumerable<LogicaNegocio.Entidades.Plano>

@{
    ViewData["Title"] = "Index";
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}


<h1>Planos</h1>

<p>
    <a href="@Url.Action("Agregar", new {idObra = ViewBag.IdObra})"> Agregar Plano</a>
</p>

<p>
    <a href="@Url.Action("SubidaMultiple", new {idObra = ViewBag.IdObra})"> Agregar Planos Múltiples</a>
</p>


    
<table class="table">
    <tbody>
@foreach (var item in ViewBag.TiposdePlano) {


        <tr>
            <td>Foto</td>  
            <td>
                    <a href="@Url.Action("ListarPlanos", new {idTipoPlano = item.Id, idObra = ViewBag.IdObra})">@item.Categoria</a>
            </td>
        </tr>
}
    </tbody>
</table>



