@model LogicaNegocio.Entidades.Carpeta

@{
    ViewData["Title"] = "Index";
}
<link href="~/css/empleado/indexempleado.css" rel="stylesheet" />

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}


<h1>Planos</h1>

<p>
    <a href="@Url.Action("Agregar", new {idObra = Model.IdObra})"> Agregar Plano</a>
</p>

<p>
    <a href="@Url.Action("SubidaMultiple", new {idObra = Model.IdObra})"> Agregar Planos Múltiples</a>
</p>

@if(Model.Anterior != null){
    <p>
        <a href="@Url.Action("Index", new {Name = Model.Anterior.Name, idObra = Model.IdObra})">Atrás</a>
    </p>
}


<table class="table">
    <tbody>
        
        @foreach (var item in ViewBag.CarpetasPosteriores)
        {
            <tr>
                <td>
                <svg class="folderIcon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
                    <path d="M64 480H448c35.3 0 64-28.7 64-64V160c0-35.3-28.7-64-64-64H288c-10.1 0-19.6-4.7-25.6-12.8L243.2 57.6C231.1 41.5 212.1 32 192 32H64C28.7 32 0 60.7 0 96V416c0 35.3 28.7 64 64 64z" />
                    </svg>


                </td>
                <td>
                    @if (item.Tipo != null)
                    {
                        <a href="@Url.Action("ListarPlanos", new {idTipoPlano = item.Tipo.Id, idObra = item.IdObra})">@item.Name</a>
                    }
                    else
                    {
                        <a href="@Url.Action("Index", new {Name = item.Name, idObra = item.IdObra})">@item.NombreFormateado()</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

