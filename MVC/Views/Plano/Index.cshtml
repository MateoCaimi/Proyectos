@model IEnumerable<LogicaNegocio.Entidades.Plano>

@{
    ViewData["Title"] = "Index";
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}


<h1>Planos</h1>

<p>
    <a href="@Url.Action("Agregar", new {idObra = ViewBag.IdObra})"> Agregar Plano</a>
</p>


    
<table class="table">
    <thead>
        <tr>
            <th>
                Nombre
            </th>
            <th>
                Cantidad
            </th>
            
        </tr>
    </thead>
    <tbody>
@foreach (var item in ViewBag.carpetas) {
        <tr>
            <td>Foto</td>  
            <td>
                    <a href="@Url.Action("ListarPlanos", new {carpeta = item.Key})"></a>  @item.Key
            </td>
            <td>
                @item.Value
            </td>
        </tr>
}
    </tbody>
</table>

