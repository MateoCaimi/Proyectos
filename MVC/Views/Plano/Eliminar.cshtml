@model LogicaNegocio.Entidades.Plano

@{
    ViewData["Title"] = "Eliminar";
}

<h1>Eliminar</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Plano</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nombre)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nombre)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TipoPlano)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TipoPlano.Categoria)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FechaPublicado)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FechaPublicado)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Obra)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Obra.Direccion)
        </dd>
    </dl>
    
    <form asp-action="Eliminar">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index" asp-route-idObra="@Model.IdObra">Back to List</a>
    </form>
</div>
