@model LogicaNegocio.Entidades.Usuario

@{
    ViewData["Title"] = "Eliminar";
}
<meta charset="UTF-8">
<link rel="stylesheet" href="~/css/Usuario/EliminarUsuario.css">


<h1>Eliminar usuario</h1>

<h3>¿Seguro que quieres eliminar a @Model.NombreUsuario)?</h3>
    <hr />

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<div class="info">
    <dl class="row">
        <dt class = "col-sm-3 label">
            @Html.DisplayNameFor(model => model.Nombre)
        </dt>
        <dd class = "col-sm-9 value">
            @Html.DisplayFor(model => model.Nombre)
        </dd>
        <dt class="col-sm-3 label">
            @Html.DisplayNameFor(model => model.NombreUsuario)
        </dt>
        <dd class="col-sm-9 value">
            @Html.DisplayFor(model => model.NombreUsuario)
        </dd>
        <dt class="col-sm-3 label">
            @Html.DisplayNameFor(model => model.Contrasenia)
        </dt>
        <dd class="col-sm-9 value">
            @Html.DisplayFor(model => model.Contrasenia)
        </dd>
        <dt class="col-sm-3 label">
            @Html.DisplayNameFor(model => model.Tipo)
        </dt>
        <dd class="col-sm-9 value">
            @Html.DisplayFor(model => model.Tipo)
        </dd>
    </dl>
</div>
    
    <form asp-action="Eliminar">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Eliminar" class="btn btn-primary" />
    </form>


    <div class="containerVolver">
        <a class="volver" asp-action="Listado">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-return-left" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M14.5 1.5a.5.5 0 0 1 .5.5v4.8a2.5 2.5 0 0 1-2.5 2.5H2.707l3.347 3.346a.5.5 0 0 1-.708.708l-4.2-4.2a.5.5 0 0 1 0-.708l4-4a.5.5 0 1 1 .708.708L2.707 8.3H12.5A1.5 1.5 0 0 0 14 6.8V2a.5.5 0 0 1 .5-.5" />
            </svg>
            Volver al listado
        </a>
    </div>

