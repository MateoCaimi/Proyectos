@model IEnumerable<LogicaNegocio.Entidades.Material>

@{
    ViewData["Title"] = "Index";
}

<meta charset="UTF-8">
<link rel="stylesheet" href="~/css/Material/index.css">
<link href="~/css/tablasresponsive.css" rel="stylesheet" />

<h1>Materiales</h1>

<p>
    <a asp-action="Agregar">Agregar material nuevo</a>
</p>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}
<form method="post">

    <div class="form-group">
        <label for="Nombre" class="control-label">Nombre: </label>
        <input id="Nombre" name="Nombre" class="form-control" />

    </div>

    <div class="form-group">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
        </svg>
        <input type="submit" value="Buscar" class="btn btnPrincipal" />
    </div>
</form>

<table class="table">
    <thead>
        <tr>

            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.UnidadDeMedida)
            </th>

            <th class="tablaAEsconder600">
                @Html.DisplayNameFor(model => model.BarreraDeStock)
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr onclick="location.href='@Url.Action("Editar", new { id = item.Id })'" style="cursor:pointer;">

                <td>
                    @Html.DisplayFor(modelItem => item.Nombre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.UnidadDeMedida)
                </td>

                <td class="tablaAEsconder600">
                    @Html.DisplayFor(modelItem => item.BarreraDeStock)
                </td>

            </tr>
        }
    </tbody>
</table>

