@model IEnumerable<LogicaNegocio.Entidades.Material>

@{
    ViewData["Title"] = "Index";
}

<meta charset="UTF-8">
<link rel="stylesheet" href="~/css/Material/index.css">

<h1>Materiales</h1>

<p>
    <a asp-action="Agregar">Agregar material nuevo</a>
</p>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}
<form method="post">

    <div class="form-group">
        <label for="Nombre" class="control-label">Nombre: </label>
        <input id="Nombre" name="Nombre" class="form-control" />
    </div>

    <div class="form-group">
        <input type="submit" value="Buscar" class="btn btnPrincipal" />
    </div>
</form>

<table class="table">
    <thead>
        <tr>

            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.UnidadDeMedida)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.BarreraDeStock)
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr onclick="location.href='@Url.Action("Editar", new { id = item.Id })'" style="cursor:pointer;">

                <td>
                    @Html.DisplayFor(modelItem => item.Nombre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.UnidadDeMedida)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.BarreraDeStock)
                </td>

            </tr>
        }
    </tbody>
</table>

