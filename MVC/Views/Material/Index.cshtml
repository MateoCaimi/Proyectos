@model IEnumerable<LogicaNegocio.Entidades.Material>

@{
    ViewData["Title"] = "Index";
}

<h1>Materiales</h1>

<p>
    <a asp-action="Agregar">Agregar material nuevo</a>
</p>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}
<form method="post">

    <div class="form-group">
        <label for="Nombre" class="control-label">Nombre: </label>
        <input id="Nombre" name="Nombre" class="form-control" />
    </div>

    <div class="form-group">
        <input type="submit" value="Buscar" class="btn btn-primary" />
    </div>
</form>

<table class="table">
    <thead>
        <tr>

            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.UnidadDeMedida)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.BarreraDeStock)
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var mat in Model)
        {
            <tr>

                <td>
                    @Html.DisplayFor(modelItem => mat.Nombre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => mat.UnidadDeMedida)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => mat.BarreraDeStock)
                </td>

                <td>
                    <a asp-action="Editar" asp-route-id="@mat.Id">Editar</a>
                </td>
               @*  <td>
                    <a asp-action="Eliminar" asp-route-id="@mat.Id">Eliminar</a> |
                </td> *@
            </tr>
        }
    </tbody>
</table>

