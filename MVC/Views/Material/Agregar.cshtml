@model LogicaNegocio.Entidades.Material

@{
    ViewData["Title"] = "Agregar";
}
<meta charset="UTF-8">
<link rel="stylesheet" href="~/css/Material/AgregarMaterial.css">
<link rel="stylesheet" href="~/css/FormularioResponsive.css">

<h1>Agregar material</h1>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Agregar">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Nombre" class="control-label">Nombre:</label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="UnidadDeMedida" class="control-label">Unidad de medida:</label>
                <input asp-for="UnidadDeMedida" class="form-control" />
                <span asp-validation-for="UnidadDeMedida" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BarreraDeStock" class="control-label">Barrera de stock:</label>
                <input asp-for="BarreraDeStock" class="form-control" />
                <span asp-validation-for="BarreraDeStock" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Agregar material" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>


<div class="containerVolver">
    <a class="volver" asp-action="Index">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-return-left" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M14.5 1.5a.5.5 0 0 1 .5.5v4.8a2.5 2.5 0 0 1-2.5 2.5H2.707l3.347 3.346a.5.5 0 0 1-.708.708l-4.2-4.2a.5.5 0 0 1 0-.708l4-4a.5.5 0 1 1 .708.708L2.707 8.3H12.5A1.5 1.5 0 0 0 14 6.8V2a.5.5 0 0 1 .5-.5" />
        </svg>
        Volver al listado
    </a>
</div>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
