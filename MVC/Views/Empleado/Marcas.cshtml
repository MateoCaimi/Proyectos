@model IEnumerable<LogicaNegocio.Entidades.Marca>

@{
    ViewData["Title"] = "Listado de marcas";
}

<h1>Listado de marcas</h1>

<form method="post">
    <div class="form-group">
        <input type="hidden" name="id" value="@ViewBag.IdEmp" />
        <label>Filtrar por obra: </label>
        <select id="IdObra" name="IdObra" class="form-control">
            @foreach (var item in ViewBag.Obras)
            {
                <option value="@item.IdObra">@item.Nombre</option>
            }
        </select>
    </div>
    <div class="form-group">
        <label>Filtrar por fechas: </label>
        <input for="Desde" class="form-control" type="date" name="Desde" />
        <input for="Hasta" class="form-control" type="date" name="Hasta" />
    </div>
    <div class="form-group">
        <button type="submit" class="btn btn-success">Filtrar</button>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Entrada)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Salida)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Empleado.Obra.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HorasExtra)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HorasLluvia)
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Entrada.Date)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Salida.Date)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Empleado.Obra.Nombre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.HorasExtra)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.HorasLluvia)
                </td>
            </tr>
        }
    </tbody>
</table>