@model IEnumerable<LogicaNegocio.Entidades.Empleado>

@{
    ViewData["Title"] = "Empleados";
}

<meta charset="UTF-8">
<link rel="stylesheet" href="~/css/Empleado/IndexEmpleado.css">

<h1>Empleados</h1>


<svg class="bi" width="32" height="32" fill="currentColor">
    <use xlink:href="bootstrap-icons.svg#heart-fill" />
</svg>


@if (TempData["Anomalia"] != "" && TempData["Anomalia"] != null)
{
    <div class="alert alert-danger">
        @TempData["Anomalia"]
    </div>
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}
<p>

    <a asp-action="Agregar">Agregar empleado</a>
    <a asp-action="AgregarTipo">Crear Tipo</a>

</p>

    <form method="post">
        <div class="form-group">
            <label>Filtrar por obra: </label>
            <select id="IdObra" name="IdObra" class="form-control">
                <option value=0>Todas</option>
                @foreach (var item in ViewBag.Obras)
                {
                    <option value="@item.IdObra">@item.Nombre</option>
                }
            </select>
        </div>
        <div class="form-group">
            <input type="submit" value="Buscar" class="btn btnPrincipal" />
        </div>
    </form>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cedula)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaIngreso)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TipoEmpleado)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CuentaBanco)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Banco)
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var inactivos = item.Activo ? "" : "resaltar-rojo";

            <tr class="@inactivos" onclick="location.href='@Url.Action("Detalles", new { id = item.Id })'" style="cursor:pointer;">
                <td>
                    @Html.DisplayFor(modelItem => item.Nombre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Cedula)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.FechaIngreso)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TipoEmpleado.Categoría)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CuentaBanco)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Banco)
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="table_footer">
    <p>Total de filas</p>
</div>
    </div>

</div>


<style>
    .resaltar-rojo {
        color: red;
    }
</style>
