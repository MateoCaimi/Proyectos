@model LogicaNegocio.Entidades.TipoEmpleado

@{
    ViewData["Title"] = "ModificarTipo";
}


<link rel="stylesheet" href="~/css/FormularioResponsive.css">
<link href="~/css/empleado/editarempleado.css" rel="stylesheet" />

<h1>Modificar categoria</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="ModificarTipo">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Categoría" class="control-label"></label>
                <input asp-for="Categoría" class="form-control" />
                <span asp-validation-for="Categoría" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ValorHora" class="control-label"></label>
                <input asp-for="ValorHora" class="form-control" data-val="false" />
                <span asp-validation-for="ValorHora" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Presentismo" class="control-label"></label>
                <input asp-for="Presentismo" class="form-control" data-val="false" />
                <span asp-validation-for="Presentismo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Compensacion" class="control-label"></label>
                <input asp-for="Compensacion" class="form-control" data-val="false" />
                <span asp-validation-for="Compensacion" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Guardar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>


<div class="containerVolver">
    <a class="volver" asp-action="ListaTipoEmpleado">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-return-left" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M14.5 1.5a.5.5 0 0 1 .5.5v4.8a2.5 2.5 0 0 1-2.5 2.5H2.707l3.347 3.346a.5.5 0 0 1-.708.708l-4.2-4.2a.5.5 0 0 1 0-.708l4-4a.5.5 0 1 1 .708.708L2.707 8.3H12.5A1.5 1.5 0 0 0 14 6.8V2a.5.5 0 0 1 .5-.5" />
        </svg>
        Volver al listado de categorias
    </a>
</div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
