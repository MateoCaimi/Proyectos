@model IEnumerable<LogicaNegocio.ViewModel.ObraEmpleadoLiquidacionViewModel>

@{
    ViewData["Title"] = "Liquidar";
}

<h1>Liquidar</h1>

<h4>Empleado</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Liquidar" asp-controller="Empleado">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <input type="hidden" name="id" value="@ViewBag.IdEmp" />
                <label>Filtrar por obra: </label>
                <select id="IdObra" name="IdObra" class="form-control">
                    @foreach (var item in ViewBag.Obras)
                    {
                        <option value="@item.IdObra">@item.Nombre</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <input type="hidden" name="id" value="@ViewBag.IdEmp" />
                <label>Filtrar por empleado: </label>
                <select id="IdEmpleado" name="IdEmpleado" class="form-control">
                    @foreach (var item in ViewBag.Empleados)
                    {
                        <option value="@item.Id">@item.Nombre</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label for="desde" class="control-label"></label>
                <input for="desde" name="desde" type="date" class="form-control" />
            </div>
            <div class="form-group">
                <label for="hasta" class="control-label"></label>
                <input for="hasta" name="hasta" type="date" class="form-control" />
            </div>
            <div class="form-group">
                <input type="submit" value="Liquidar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ObraEmpleado.Empleado.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ObraEmpleado.Empleado.Cedula)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ObraEmpleado.Empleado.TipoEmpleado)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ObraEmpleado.Empleado.CuentaBanco)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ObraEmpleado.Empleado.Banco)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Liquidacion)
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.ObraEmpleado.Empleado.Nombre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ObraEmpleado.Empleado.Cedula)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ObraEmpleado.Empleado.TipoEmpleado.Categoría)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ObraEmpleado.Empleado.CuentaBanco)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ObraEmpleado.Empleado.Banco)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Liquidacion)
                </td>
            </tr>
        }
    </tbody>
</table>

