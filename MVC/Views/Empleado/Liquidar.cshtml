@model IEnumerable<LogicaNegocio.ViewModel.ObraEmpleadoLiquidacionViewModel>

@{
    ViewData["Title"] = "Liquidar";

}

<h1>Liquidar</h1>

<h4>Empleado</h4>
<hr />

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}
<div class="row">
    <div class="col-md-4">
        <form asp-action="Liquidar" asp-controller="Empleado">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <input type="hidden" name="id" value="@ViewBag.IdObra" />
                <label>Filtrar por obra: </label>
                <select id="IdObra" name="IdObra" class="form-control">
                    <option value=null>Todas</option>

                    @foreach (var item in ViewBag.Obras)
                    {
                        <option value="@item.IdObra">@item.Nombre</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <input type="hidden" name="id" value="@ViewBag.IdEmp" />
                <label>Filtrar por empleado: </label>
                <div id="IdEmpleado">
                    <select id="IdEmpleado" name="IdEmpleado" class="form-control">
                        <option value=null>Todos</option>

                        @foreach (var item in ViewBag.Empleados)
                        {
                            <option value="@item.Id">@item.Nombre</option>
                        }
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label for="desde" class="control-label"></label>
                <input for="desde" name="desde" type="date" class="form-control" />
            </div>
            <div class="form-group">
                <label for="hasta" class="control-label"></label>
                <input for="hasta" name="hasta" type="date" class="form-control" />
            </div>
            <div class="form-group">
                <input type="submit" value="Liquidar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<br />


<form asp-controller="Empleado" asp-action="DescargarPDF" method="post">
    
    <button type="submit" class="btn btn-primary">Descargar PDF</button>

    @for (int i = 0; i < Model.Count(); i++)
    {
        <input type="hidden" name="ObraEmpleadoLiquidacionViewModelList[@i].ObraEmpleado.Empleado.Nombre" value="@Model.ElementAt(i).ObraEmpleado.Empleado.Nombre" />
        <input type="hidden" name="ObraEmpleadoLiquidacionViewModelList[@i].ObraEmpleado.Empleado.Cedula" value="@Model.ElementAt(i).ObraEmpleado.Empleado.Cedula" />
        <input type="hidden" name="ObraEmpleadoLiquidacionViewModelList[@i].ObraEmpleado.Empleado.Banco" value="@Model.ElementAt(i).ObraEmpleado.Empleado.Banco" />
        <input type="hidden" name="ObraEmpleadoLiquidacionViewModelList[@i].ObraEmpleado.Empleado.CuentaBanco" value="@Model.ElementAt(i).ObraEmpleado.Empleado.CuentaBanco" />
        <input type="hidden" name="ObraEmpleadoLiquidacionViewModelList[@i].Liquidacion" value="@Model.ElementAt(i).Liquidacion" />
        <!-- Añadir otros campos aquí -->
    }
</form>


<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ObraEmpleado.Empleado.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ObraEmpleado.Empleado.Cedula)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ObraEmpleado.Empleado.TipoEmpleado)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ObraEmpleado.Empleado.CuentaBanco)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ObraEmpleado.Empleado.Banco)
            </th>
            <th>

                @Html.DisplayNameFor(model => model.Liquidacion)
                 @if (ViewBag.TotalLiquidacion != null){
                <p>
                     Total: @ViewBag.TotalLiquidacion
                </p>
                 }

            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.ObraEmpleado.Empleado.Nombre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ObraEmpleado.Empleado.Cedula)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ObraEmpleado.Empleado.TipoEmpleado.Categoría)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ObraEmpleado.Empleado.CuentaBanco)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ObraEmpleado.Empleado.Banco)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Liquidacion)
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts
{

    <script>
        $(function () {
            $("#IdObra").on("change", function () {
                var IdObra = $(this).val();
                $("#IdEmpleado").empty();
                $.ajax({
                    url: '@Url.Action("CambiarListadoLiquidacion", "Empleado")',
                    type: 'GET',
                    data: {
                        IdObra: IdObra,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {
                        $("#IdEmpleado").html(response);
                    },
                    error: function () {
                        alert("Error al seleccionar la obra. Inténtalo de nuevo.");
                    }
                });
            });
        });


    </script>
}