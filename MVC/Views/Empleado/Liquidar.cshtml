@model LogicaNegocio.Entidades.ObraEmpleado

@{
    ViewData["Title"] = "Liquidar";
}

<h1>Liquidar</h1>

<h4>Empleado</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Liquidar" asp-controller="Empleado">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdObra" />
            <input type="hidden" asp-for="IdEmpleado" />
            <div class="form-group">
                <label for="desde" class="control-label"></label>
                <input for="desde" name="desde" type="date" class="form-control" />
            </div>
            <div class="form-group">
                <label for="hasta" class="control-label"></label>
                <input for="hasta" name="hasta" type="date" class="form-control" />
            </div>
            <div class="form-group">
                <input type="submit" value="Liquidar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

