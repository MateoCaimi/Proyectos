@model LogicaNegocio.Entidades.ObraEmpleado

@{
    ViewData["Title"] = "Dar Egreso";
}

<h1>Dar Egreso</h1>

<h4>Empleado</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Egreso" asp-controller="Empleado">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdObra" />
            <input type="hidden" asp-for="IdEmpleado" />
            <div class="form-group">
                <label for="Dia" class="control-label"></label>
                <input for="Dia" name="Dia" type="date" class="form-control" />
            </div>
            <div class="form-group">
                <input type="submit" value="Egreso" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
