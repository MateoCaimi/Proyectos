@model LogicaNegocio.Entidades.Solicitud

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}   
<div>
    <h4>Solicitud</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Proveedor)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Proveedor.Mail)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Obra)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Obra.Direccion)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Solicitante)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Solicitante.Nombre)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Aprovador)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Aprovador.Nombre)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Estado)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Estado)
        </dd>
    </dl>
</div>
    @if(Model.Estado == LogicaNegocio.Entidades.Estado.Solicitado)
    {
        @using (Html.BeginForm("Aprobar", "Solicitud", FormMethod.Post))
        {
        <table class="table">
            <thead>
                <tr>
                    <th>Material</th>
                    <th>Cantidad</th>
                    <th>Aceptar</th>
                </tr>
            </thead>
            <tbody id="materialList">
                @if (Model != null)
                {
                    foreach (var item in ViewBag.Materiales)
                    {
                        <tr>
                            <td>@item.Material.Nombre</td>
                            <td>
                                <input type="number" name="Cantidad_@item.Material.Id" value="@item.Cantidad" min="1" />
                                @item.Material.UnidadDeMedida
                                <input type="hidden" name="@item.IdMaterial" value="@item.Material.Id" />
                            </td>
                            <td>
                                <input type="checkbox" name="materialesSeleccionados" value="@item.Material.Id" />
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <br />

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">
                @ViewBag.Error
            </div>
        }
        @if (ViewBag.Mensaje != null)
        {
            <div class="alert alert-danger">
                @ViewBag.Mensaje
            </div>
        }


        <input type="hidden" name="SolicitudId" value="@Model.Id" />

        <button class="btn btn-primary" id="btnConfirmar" type="submit">Aceptar solicitud</button>

        }
    <br />
       <div>
        <form method="post" action="@Url.Action("Rechazar", "Solicitud")">
            <input type="hidden" name="SolicitudId" value="@Model.Id" />
            <button type="submit" class="btn btn-danger">Rechazar solicitud</button>
        </form>
    </div>
    }
 
    @if (Model.Estado == LogicaNegocio.Entidades.Estado.Aprobado)
{
    <br />
        <div>
            <form method="post" action="@Url.Action("Confirmar", "Solicitud")">
                <input type="hidden" name="SolicitudId" value="@Model.Id" />
                <button type="submit" class="btn btn-info">Confirmar solicitud</button>
            </form>
        </div>
    }

<div>
    <a asp-action="Index" asp-route-idObra="@ViewBag.IdObra">>Back to List</a>
</div>




<script>
    document.getElementById("btnConfirmar").addEventListener("click", function () {
     
        setTimeout(function () {
            window.location.href = '@Url.Action("Index", "Solicitud", new { idObra = @Model.IdObra })'; //esto es prueba para redirigir a el confirmar q te tira para el index
        }, 500); // 0.5 segundo de retraso
    });
</script> 
