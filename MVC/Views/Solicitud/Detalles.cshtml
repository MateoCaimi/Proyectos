@model LogicaNegocio.Entidades.Solicitud

@{
    ViewData["Title"] = "Details";
}

<meta charset="UTF-8">
<link rel="stylesheet" href="~/css/Solicitud/DetallesSolicitud.css">
<link rel="stylesheet" href="~/css/FormularioResponsive.css">

<h1>Detalles de la solicitud de la obra @ViewBag.NomObra</h1>

<hr />
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}
@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-danger">
        @ViewBag.Mensaje
    </div>
}
<div class="info">
    <dl class="row">
        <dt class="col-sm-3 label">
            @Html.DisplayNameFor(model => model.Obra)
        </dt>
        <dd class="col-sm-9 value">
            @Html.DisplayFor(model => model.Obra.Direccion)
        </dd>
        <dt class="col-sm-3 label">
            @Html.DisplayNameFor(model => model.Solicitante)
        </dt>
        <dd class="col-sm-9 value">
            @Html.DisplayFor(model => model.Solicitante.Nombre)
        </dd>
        <dt class="col-sm-3 label">
            @Html.DisplayNameFor(model => model.Aprovador)
        </dt>
        <dd class="col-sm-9 value">
            @Html.DisplayFor(model => model.Aprovador.Nombre)
        </dd>
        <dt class="col-sm-3 label">
            @Html.DisplayNameFor(model => model.Estado)
        </dt>
        <dd class="col-sm-9 value">
            @Html.DisplayFor(model => model.Estado)
        </dd>
        <dd class="col-sm-9 value">
            @Html.DisplayFor(model => model.Comentario)
        </dd>
    </dl>
</div>
@if (Model.Estado == LogicaNegocio.Entidades.Estado.Solicitado)
{
    @using (Html.BeginForm("Aprobar", "Solicitud", FormMethod.Post))
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Material</th>
                    <th>Cantidad</th>
                    <th>Aceptar</th>
                </tr>
            </thead>
            <tbody id="materialList">
                @if (Model != null)
                {
                    foreach (var item in ViewBag.Materiales)
                    {
                        <tr>
                            <td>@item.Material.Nombre (@item.Material.UnidadDeMedida)</td>
                            <td>
                                <input type="number" name="Cantidad_@item.Material.Id" value="@item.Cantidad" min="1" />
                            </td>
                            <td>
                                <input type="checkbox" name="materialesSeleccionados" value="@item.Material.Id" />
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

    <div class="botones">

        @if (Context.Session.GetString("UsuarioTipo") == "Usuario de oficina")
        {

        <input type="hidden" name="idSolicitud" value="@Model.Id" />
        <button class="btn btnAceptar" id="btnConfirmar" type="submit">Aceptar solicitud</button>
        }

        @if (Context.Session.GetString("UsuarioTipo") == "Usuario de oficina")
        {
            <form method="post" action="@Url.Action("Rechazar", "Solicitud")">
                <input type="hidden" name="idSolicitud" value="@Model.Id" />
                <button type="submit" class="btn btnRechazar">Rechazar solicitud</button>
            </form>
        }

    </div>
    }

}


<hr />

<div class="containerVolver">
    <a class="volver" asp-action="Index" asp-route-idObra="@Model.IdObra">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-return-left" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M14.5 1.5a.5.5 0 0 1 .5.5v4.8a2.5 2.5 0 0 1-2.5 2.5H2.707l3.347 3.346a.5.5 0 0 1-.708.708l-4.2-4.2a.5.5 0 0 1 0-.708l4-4a.5.5 0 1 1 .708.708L2.707 8.3H12.5A1.5 1.5 0 0 0 14 6.8V2a.5.5 0 0 1 .5-.5" />
        </svg>
        Volver al listado
    </a>
</div>




<script>
    document.getElementById("btnConfirmar").addEventListener("click", function () {

        setTimeout(function () {
            window.location.href = '@Url.Action("Index", "Solicitud", new { idObra = @Model.IdObra })'; //esto es prueba para redirigir a el confirmar q te tira para el index
        },1500); // 0.5 segundo de retraso
    });
</script>
