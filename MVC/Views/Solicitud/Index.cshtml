@model IEnumerable<LogicaNegocio.Entidades.Solicitud>

@{
    ViewData["Title"] = "Index";
}

<meta charset="UTF-8">
<link rel="stylesheet" href="~/css/Solicitud/IndexSolicitud.css">

<h1>Solcitudes de obra</h1>
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}
<p>
    <a href="@Url.Action("Crear", new {idObra = ViewBag.IdObra})"> Crear Solicitud</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Proveedor)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Obra)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Solicitante)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Aprovador)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Estado)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
            <tr>
            @* <tr onclick="location.href='@Url.Action("Editar", new { id = item.Id })'" style="cursor:pointer;"> *@

                <td>
                @Html.DisplayFor(modelItem => item.Proveedor.Mail)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Obra.Direccion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Solicitante.Nombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Aprovador.Nombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Estado)
            </td>
            <td>
                    @if (item.Estado == LogicaNegocio.Entidades.Estado.Solicitado)
                    {
                        <a asp-action="Detalles" asp-route-idSolicitud="@item.Id" >Detalles</a>
                    }
                    @if (item.Estado == LogicaNegocio.Entidades.Estado.Aprobado)
                    {
                        <a asp-action="Confirmar" asp-route-idSolicitud="@item.Id" >Confirmar</a>
                    }
                    @if (item.Estado == LogicaNegocio.Entidades.Estado.Recibido || item.Estado == LogicaNegocio.Entidades.Estado.Visto)
                    {
                        <a asp-action="Confirmar" asp-route-idSolicitud="@item.Id">Ver solicitud</a>
                    }
            </td>
        </tr>
}
    </tbody>
</table>
