@model IEnumerable<LogicaNegocio.Entidades.SolicitudMaterial>

@{
    ViewData["Title"] = "Solicitud de material";

}

<meta charset="UTF-8">
<link rel="stylesheet" href="~/css/Solicitud/AgregarSolicitud.css">


<h1>Solicitud de material</h1>


@if (TempData["ErrorNoMateriales"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorNoMateriales"]

    </div>
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}
else
{
    @using (Html.BeginForm("Crear", "Solicitud", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label>Nombre de la obra</label>
            <input type="text" class="form-control" value="@ViewBag.IdObra" name="IdObra" readonly="readonly" />
        </div>

        <div class="form-group">
            <label>Material</label>
            <select id="Material" name="Material" class="form-control">
                @foreach (var item in ViewBag.Materiales)
                {
                    <option value="@item.Id">@item.Nombre (@item.UnidadDeMedida)</option>
                }
            </select>
        </div>
        <div class="form-group">

            <label>Cantidad</label>
            <input type="number" name="Cantidad" class="form-control" />
        </div>
        <input type="hidden" name="idObra" value="@ViewBag.IdObra" />
        <button type="button" id="addItem" class="btn btnAgregar">Agregar</button>

        <table class="table">
            <thead>
                <tr>
                    <th>Material</th>
                    <th>Cantidad</th>
                </tr>
            </thead>
            <tbody id="materialList">
                @if (Model != null)
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Material.Nombre</td>
                            <td>@item.Cantidad</td>
                        </tr>
                    }

                }
            </tbody>
        </table>

        <button type="submit" class="btn btnPrincipal" >Enviar</button>
    }
}

@section Scripts {
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script>
        $(document).ready(function () {
            $("#addItem").click(function () {
                var nuevoMaterialId = $("select[name='Material'] option:selected").val();
                var nuevoMaterialTexto = $("select[name='Material'] option:selected").text();
                var nuevaCantidad = $("input[name='Cantidad']").val();

                if (nuevoMaterialId != null && nuevaCantidad > 0) {

                    $.ajax({
                        url: '@Url.Action("Agregar", "Solicitud", Model.ToList())',
                        type: 'POST',
                        data: {
                            IdMaterial: nuevoMaterialId,
                            Cantidad: nuevaCantidad,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (response) {
                            $("#materialList").html(response);
                            $("input[name='Cantidad']").val('');
                        },
                        error: function () {
                            alert("Error al agregar el material. Inténtalo de nuevo.");
                        }

                        

                    });
                } else {
                    alert("La cantidad no puede ser menor a 0");
                }
            });
        });


    </script>
}
