@model LogicaNegocio.Entidades.Solicitud

@{
    ViewData["Title"] = "Confirmar";
}
<meta charset="UTF-8">
<link rel="stylesheet" href="~/css/Solicitud/CinfirmarSolicitud.css">
<link rel="stylesheet" href="~/css/FormularioResponsive.css">

@if (Model.Estado == LogicaNegocio.Entidades.Estado.Aprobado)
{
<h1>Confirmar</h1>

}

<h1>Ver solicitud </h1>
    <hr />

<div>
    <dl class="row">
        <dt class = "col-sm-3 label">
            @Html.DisplayNameFor(model => model.Obra)
        </dt>
        <dd class = "col-sm-9 value">
            @Html.DisplayFor(model => model.Obra.Direccion)
        </dd>
        <dt class="col-sm-3 label">
            @Html.DisplayNameFor(model => model.Solicitante)
        </dt>
        <dd class="col-sm-9 value">
            @Html.DisplayFor(model => model.Solicitante.Contrasenia)
        </dd>
        <dt class="col-sm-3 label">
            @Html.DisplayNameFor(model => model.Aprovador)
        </dt>
        <dd class="col-sm-9 value">
            @Html.DisplayFor(model => model.Aprovador.Contrasenia)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Comentario)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Comentario)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Estado)
        </dt>
        <dd class="col-sm-9 value">
            @Html.DisplayFor(model => model.Estado)
        </dd>
    </dl>


    <table class="table">
        <thead>
            <tr>
                <th>Material</th>
                <th>Cantidad</th>
            </tr>
        </thead>
        <tbody id="materialList">
            @if (Model != null)
            {
                foreach (var item in ViewBag.Materiales)
                {
                    <tr>
                        <td>@item.Material.Nombre (@item.Material.UnidadDeMedida)</td>
                        <td>
                            @item.Cantidad
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
    @if(Model.Estado == LogicaNegocio.Entidades.Estado.Aprobado)
    {
        
    <form asp-action="Confirmar">
        <input type="hidden" name="idSolicitud" value="@Model.Id" />
        <input type="submit" value="Confirmar" class="btn btnConfirmar" />
    </form>
    }


    <hr />

    <div class="containerVolver">
        <a class="volver" asp-action="Index" asp-route-idObra="@Model.IdObra">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-return-left" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M14.5 1.5a.5.5 0 0 1 .5.5v4.8a2.5 2.5 0 0 1-2.5 2.5H2.707l3.347 3.346a.5.5 0 0 1-.708.708l-4.2-4.2a.5.5 0 0 1 0-.708l4-4a.5.5 0 1 1 .708.708L2.707 8.3H12.5A1.5 1.5 0 0 0 14 6.8V2a.5.5 0 0 1 .5-.5" />
            </svg>
            Volver al listado
        </a>
    </div>

</div>
