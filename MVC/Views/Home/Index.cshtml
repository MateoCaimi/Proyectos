@model IEnumerable<LogicaNegocio.Entidades.Solicitud>
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
    <h2>Notificaciones</h2>
   

    @if(Model != null){

        <table class="table">
            <thead>
                <tr>
                    <th>SOLICITUDES</th>
                </tr>
                <tr>
                    <th>
                        Obra
                    </th>
                    <th>
                        Solicitante
                    </th>
                    <th>
                        Estado
                    </th>
                    <th>

                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Obra)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Solicitante.Nombre)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Estado)
                        </td>
                        <td>
                            <a href="@Url.Action("Details", "Solicitud", new { id = item.Id, idObra = item.IdObra})" target="_blank">Ver Solicitud</a>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

</div>
